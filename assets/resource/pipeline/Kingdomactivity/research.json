{
    "research_choose":{
        "recognition":{
            "type":"TemplateMatch",
            "param":{
                "template" : "kingdomactivity/research.png",
                "threshold":0.8
            }
        },
        "action":{
            "type":"Click"
        },
        "next": [
            "research_page"
        ]
    },
    "research_page":{
        "recognition":{
            "type":"OCR",
            "param":{
                "roi" : [65,9,248,58],
                "expected" : "糖糖地精研究室",
                "only_rec":true
            }
        },
        "next": [
            "[JumpBack]bottom_click",
            "check_research",
            "research_done"
        ]
    },
    "research_done":{
        "action":{
            "type":"Custom",
            "param":{
                "custom_action":"NodeOverride",
                "custom_action_param":{
                    "research_page":{
                        "enabled":false
                    }
                }
            }
        },
        "next":[
            "returnmainpage"
        ]
    },
    "check_research":{
        "recognition":{
            "type":"OCR",
            "param":{
                "expected":[
                    "2/2",
                    "3/3"
            ],
                "roi" : [410, 82, 110, 37]
            }
        },
        "next":[
            "quick_research_choose",
            "research_done"
        ],
        "inverse":true,
        "post_delay":2000
    },
    "quick_research_choose":{
        "recognition":{
            "type":"OCR",
            "param":{
                "expected":"快速选择研究",
                "roi" : [43, 652, 194, 54]
            }
        },
        "action":{
            "type":"Click"
        },  
        "next":[
                "auto_research_choose"
            ]
    },
    "auto_research_choose":{
        "recognition":{
            "type":"OCR",
            "param":{
                "expected":"自动选择研究"
            }
        },
        "action":{
            "type":"Click"
        },
        "next":[
            "research_confirm"
        ]
    },
    "research_confirm":{
        "recognition":{
            "type":"OCR",
            "param":{
                "expected":"研究",
                "roi" : [793, 564, 197, 45]
            }
        },
        "action":{
            "type":"Click"
        },
        "next":[
            "research_done"
        ]
    }
}